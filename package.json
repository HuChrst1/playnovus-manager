{
  "name": "playnovus-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:webpack": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:biome && npm run lint:next-img-guard && npm run lint:ui-contrast",
    "lint:biome": "biome lint .",
    "lint:next-img-guard": "node scripts/check_no_img_element.mjs",
    "lint:ui-contrast": "node scripts/ui_contrast_audit.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "audit:deps": "npm ls ajv @eslint/eslintrc eslint || true",
    "test:f2.0": "node scripts/f2_0_validate_local.mjs",
    "test:f7.3:pre": "node scripts/f7_3_validate_local.mjs --checkpoint pre-release",
    "test:f7.3:post": "node scripts/f7_3_validate_local.mjs --checkpoint post-release",
    "test:f7.3": "npm run test:f7.3:pre && npm run test && npm run test:f2.0 && npm run test:f7.3:post",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/fifo.test.mjs",
    "test:integration": "node scripts/f7_1_validate_local.mjs && npm run test:f2.0",
    "test:e2e": "node -e \"console.log('[INFO] E2E browser tests hors scope F7.1.');\""
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.86.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.555.0",
    "next": "^16.1.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.19",
    "supabase": "^2.65.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "supabase": {
      "tar": "7.5.9"
    }
  }
}
